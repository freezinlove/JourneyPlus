# Keep local credentials, data and build caches out of future Docker contexts.
.git
.env
.env.*
!.env.example
.secrets
.local
**/credentials.json
**/token.json
**/*.pem
**/*.key
**/*.jks
**/*.keystore
**/*.db
**/*.db-*
**/*.sqlite*
**/*.dump
**/*.log
.venv
**/__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
.coverage*
htmlcov
**/node_modules
clients/web/dist
clients/web/test-results
clients/web/playwright-report
clients/web/*.tsbuildinfo
clients/android/.gradle
clients/android/.kotlin
clients/android/**/build
clients/android/local.properties
doc/database-archives
doc/agent-live-modelport-audit
doc/agent-natural-language
doc/agent-runtime-repair
evaluation/runs
**/.DS_Store
