**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.db
**/*.db-*
**/*.sqlite*
**/*.dump
**/*.log
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.coverage*
htmlcov
**/node_modules
clients/web/dist
clients/web/test-results
clients/web/playwright-report
clients/web/*.tsbuildinfo
clients/web/coverage
