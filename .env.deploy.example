# 填写 openssl rand -hex 32 生成的密码（必填）
JOURNEYPLUS_POSTGRES_PASSWORD=
JOURNEYPLUS_AI_PROVIDER=aliyun-model-studio
JOURNEYPLUS_AI_REGION=cn-beijing
JOURNEYPLUS_AI_MODEL=deepseek-v4-flash
JOURNEYPLUS_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JOURNEYPLUS_AI_API_KEY=
JOURNEYPLUS_AI_TIMEOUT_SECONDS=180
JOURNEYPLUS_GMAIL_CLIENT_SECRET_FILE=.secrets/google-oauth-client.json
JOURNEYPLUS_GMAIL_TOKEN_FILE=.secrets/gmail-token.json
JOURNEYPLUS_AUTOMATION_SOURCE_ITEM_LIMIT=100
JOURNEYPLUS_AUTOMATION_DOCUMENT_LIMIT=20
JOURNEYPLUS_AUTOMATION_MODEL_CALL_LIMIT=100
JOURNEYPLUS_AUTOMATION_LEASE_SECONDS=3600
JOURNEYPLUS_GENERIC_ARTICLE_PIPELINE=v2
JOURNEYPLUS_GENERIC_TITLE_DROP_ENABLED=true
# Agent 独立配置；模型窗口必须按实际模型填写，不能猜测。
JOURNEYPLUS_AGENT_MODEL=deepseek-v4-flash
JOURNEYPLUS_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JOURNEYPLUS_AGENT_API_KEY=
JOURNEYPLUS_AGENT_CONTEXT_WINDOW=0
# Per-request input target (instructions, tools and history); latest turn remains atomic.
JOURNEYPLUS_AGENT_CONTEXT_TOKEN_BUDGET=500000
JOURNEYPLUS_AGENT_PROTOCOL=auto
JOURNEYPLUS_AGENT_TEMPERATURE=0.2
JOURNEYPLUS_AGENT_THINKING=false
# Opt in only on a provider supporting content cache_control.type=ephemeral.
JOURNEYPLUS_AGENT_EXPLICIT_CACHE=false
JOURNEYPLUS_AGENT_NETWORK_ENABLED=false
# 同时控制模型等待工具和后台检查；重新启用后重启 Agent 服务。
JOURNEYPLUS_AGENT_WAITING_ENABLED=false
JOURNEYPLUS_AGENT_INPUT_TOKEN_SOFT=450000
JOURNEYPLUS_AGENT_INPUT_TOKEN_LIMIT=500000

# Persist per-request model timing diagnostics (restart service after changing).
JOURNEYPLUS_AGENT_MODEL_TIMING_ENABLED=true

# 先通过 SSH 隧道测试，暂不开放公网 HTTP。
JOURNEYPLUS_BIND_HOST=127.0.0.1
JOURNEYPLUS_HTTP_PORT=8000

# 不同部署环境使用不同的登录 Cookie 名称。
JOURNEYPLUS_SESSION_COOKIE_NAME=journeyplus_cloud_session
