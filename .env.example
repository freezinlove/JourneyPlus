JOURNEYPLUS_POSTGRES_PORT=5433
JOURNEYPLUS_DATABASE_URL=postgresql+psycopg://journeyplus:change-me@localhost:5433/journeyplus
JOURNEYPLUS_AI_PROVIDER=aliyun-model-studio
JOURNEYPLUS_AI_REGION=cn-beijing
JOURNEYPLUS_AI_MODEL=deepseek-v4-flash
JOURNEYPLUS_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JOURNEYPLUS_AI_API_KEY=
JOURNEYPLUS_AI_TIMEOUT_SECONDS=180
JOURNEYPLUS_GMAIL_CLIENT_SECRET_FILE=.secrets/google-oauth-client.json
JOURNEYPLUS_GMAIL_TOKEN_FILE=.secrets/gmail-token.json
JOURNEYPLUS_AUTOMATION_SOURCE_ITEM_LIMIT=100
JOURNEYPLUS_AUTOMATION_DOCUMENT_LIMIT=20
JOURNEYPLUS_AUTOMATION_MODEL_CALL_LIMIT=100
JOURNEYPLUS_AUTOMATION_LEASE_SECONDS=3600
JOURNEYPLUS_GENERIC_ARTICLE_PIPELINE=v2
